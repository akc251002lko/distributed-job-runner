APP_ENV=development
DATABASE_URL=postgres://djr_owner:djr-owner-local-only@localhost:5432/djr?sslmode=disable
API_DATABASE_URL=postgres://djr_api:local-api-only@localhost:5432/djr?sslmode=disable
WORKER_DATABASE_URL=postgres://djr_worker:local-worker-only@localhost:5432/djr?sslmode=disable
API_ADDR=:8080
API_TOKEN=
# Optional comma-separated client_id=32+_character_token entries.
API_KEYS=
API_RATE_LIMIT_RPS=10
API_RATE_LIMIT_BURST=20
WORKER_ID=worker-local
WORKER_CONCURRENCY=4
POLL_INTERVAL=1s
LEASE_DURATION=30s
WORKER_METRICS_ADDR=:9090
